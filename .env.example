# OpenAI APIキー(必須。WebSearchToolを利用するため、Web検索が有効なキーが必要)
OPENAI_API_KEY=

# 使用するモデル(任意。既定: gpt-5.4)
OOD_AGENT_MODEL=

# 記事執筆に使うモデル(任意。既定: OOD_AGENT_MODEL と同じ)
OOD_WRITER_MODEL=

# レポートファイルの出力先ディレクトリ(任意。既定: output)
OUTDIR=

# 調査ログ(調査回ごとのファイル)の保存ディレクトリ(任意。既定: .research_log)
LOGDIR=

# 調査対象期間(日数)(任意。既定: 30)
WINDOW_DAYS=

# 調査担当Agentへ渡す過去の調査ログの件数(調査回数)の上限
# (任意。0以下で上限なし。既定: 10)
MAX_LOG_RUNS=

# 調査対象期間の基準日(任意。YYYY-MM-DD。既定: 実行日)
BASE_DATE=

# ログの出力レベル(任意。DEBUG/INFO/WARNING/ERROR/CRITICAL。既定: WARNING)
OOD_LOG_LEVEL=
