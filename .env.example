# OpenAI APIキー(必須。WebSearchToolを利用するため、Web検索が有効なキーが必要)
OPENAI_API_KEY=

# 使用するモデル(任意。既定: gpt-5.4)
OOD_AGENT_MODEL=

# 記事再構成に使うモデル(任意。既定: OOD_AGENT_MODEL と同じ)
OOD_WRITER_MODEL=

# レポートファイルの出力先ディレクトリ(任意。既定: output)
OUTDIR=

# 調査対象期間(日数)(任意。既定: 30)
WINDOW_DAYS=

# ログの出力レベル(任意。DEBUG/INFO/WARNING/ERROR/CRITICAL。既定: WARNING)
OOD_LOG_LEVEL=
