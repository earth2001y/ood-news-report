# OpenAI API key (required; must support WebSearchTool)
OPENAI_API_KEY=

# Slack Incoming Webhook URL (optional; default: unset)
#SLACK_WEBHOOK_URL=

# Model used for research (optional; default: gpt-5.4)
#AGENT_MODEL=gpt-5.4

# Model used for article writing (optional; default: same as AGENT_MODEL)
#WRITER_MODEL=gpt-5.4

# Report output directory (optional; default: output)
#OUTDIR=output

# Research log directory, with one file per run (optional; default: .research_log)
#LOGDIR=.research_log

# Research window in days (optional; default: 30)
#WINDOW_DAYS=30

# Maximum number of past research runs passed to the researcher Agent
# (optional; -1 or lower means unlimited; default: 10)
#MAX_LOG_RUNS=10

# Base date for the research period (optional; YYYY-MM-DD; default: execution date)
#BASE_DATE=

# Log level (optional; DEBUG/INFO/WARNING/ERROR/CRITICAL; default: WARNING)
#LOG_LEVEL=WARNING
